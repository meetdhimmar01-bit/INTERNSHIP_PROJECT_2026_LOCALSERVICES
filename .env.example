DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-random-local-development-key
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Use a local PostgreSQL URL if you need the existing local database.
# Omit this to use the development SQLite database.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Cloudinary is required in production for persistent uploaded images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SITE_URL=http://127.0.0.1:8000
